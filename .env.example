# Local models served by Ollama (defaults shown). Nothing else is required.
EAT_MODEL=qwen3.5-4b-16k:latest
EAT_FALLBACK_MODEL=gemma2:9b
EAT_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# Observability: Langfuse over OTLP (optional; Agno DB traces always on)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# AgentOS bearer auth + cron for the periodic supervisor check
OS_SECURITY_KEY=
EAT_CHECK_CRON=*/30 * * * *

# Tests / CI only: rule-based simulator instead of Ollama
# EAT_OFFLINE=1
